{
  "name": "dailyx",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm --filter @dailyx/web dev",
    "build": "pnpm --filter @dailyx/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "pnpm --filter @dailyx/web test:e2e",
    "knip": "knip",
    "db:generate": "pnpm --filter @dailyx/db generate",
    "db:migrate": "pnpm --filter @dailyx/db migrate"
  },
  "devDependencies": {
    "@dailyx/config": "workspace:*",
    "eslint": "10.11.0",
    "knip": "6.38.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
