# Copy to apps/web/.env.local. Blank = unset.
# "production" on Vercel production; unset locally. The seed refuses to run in production.
APP_ENV=
# Neon pooled connection string. Unset → local PGlite at <repo>/.data/pglite.
DATABASE_URL=
# Optional PGlite data dir (or memory://). Ignored when DATABASE_URL is set.
PGLITE_DIR=
# 32+ random chars: openssl rand -base64 32. Required in production.
BETTER_AUTH_SECRET=
# http://localhost:3000 locally; the production origin on Vercel.
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth client (redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The one Google account allowed to sign in. Also the seed user's email.
ALLOWED_EMAIL=
